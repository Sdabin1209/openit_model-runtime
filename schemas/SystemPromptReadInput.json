{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemPromptReadInput",
  "description": "system_prompt_read의 입력: 어댑터 디렉터리와 SystemPromptRef({path, sha256}).",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "adapter_dir": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "role",
    "adapter_dir",
    "ref"
  ],
  "additionalProperties": false
}
