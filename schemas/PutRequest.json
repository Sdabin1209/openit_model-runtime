{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PutRequest",
  "description": "release_registry 적재 신호의 입력.",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "required": [
    "release_id"
  ],
  "additionalProperties": false
}
