{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferRequest",
  "description": "release_registry 추론의 입력. body는 HTTP 본문(계약 ExtractRequest 또는 ResponseRequest)이며 형식 판정은 registry가 계약으로 한다.",
  "type": "object",
  "properties": {
    "release_id": {
      "$ref": "https://openit.example/contracts/v5/_common.schema.json#/$defs/Id"
    },
    "op": {
      "enum": [
        "extract",
        "respond"
      ]
    },
    "body": true
  },
  "required": [
    "release_id",
    "op",
    "body"
  ],
  "additionalProperties": false
}
