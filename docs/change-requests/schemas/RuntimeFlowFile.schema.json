{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.local/boundary-contracts/RuntimeFlowFile.schema.json",
  "title": "RuntimeFlowFile",
  "description": "초안(CR-006). 가짜(fake)·모방(mimic) 백엔드의 문항 흐름 파일(MODEL_RUNTIME_FAKE_FLOW_FILE, MODEL_RUNTIME_MIMIC_FLOW_FILE). deploy·survey-service의 시험 설정이 만들고 model-runtime의 가짜·모방 백엔드가 읽는다. 문항 순서와 건너뛰기는 survey-service QuestionFlow·turn-engine 흐름 표와 같은 뜻이어야 한다(그 쪽이 정본이고 이 파일은 복사본이므로 어긋날 수 있다, 감사 MR-07). 두 형식: 문항 ID 목록(배열) 또는 객체. 객체의 모르는 키는 거부한다: 지금 코드는 모르는 키를 무시해 `skip`처럼 오타가 조용히 사라지므로 닫는 것이 제안이다(코드보다 엄격).",
  "oneOf": [
    {"type": "array", "items": {"$ref": "#/$defs/itemId"}, "minItems": 1, "uniqueItems": true},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["order"],
      "properties": {
        "order": {"type": "array", "items": {"$ref": "#/$defs/itemId"}, "minItems": 1, "uniqueItems": true},
        "slots": {"type": "object", "propertyNames": {"$ref": "#/$defs/itemId"},
                  "additionalProperties": {"type": "array", "minItems": 1, "items": {
                    "type": "object", "additionalProperties": false, "required": ["key", "type"],
                    "properties": {"key": {"$ref": "#/$defs/modelKey"}, "type": {"enum": ["boolean", "integer"]}}}}},
        "skips": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["slot", "value", "skip_item"],
          "properties": {"slot": {"type": "string", "minLength": 1}, "op": {"const": "=="}, "value": {"type": ["boolean", "number", "string"]}, "skip_item": {"$ref": "#/$defs/itemId"}}}},
        "corrections": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["contains", "key", "value"],
          "properties": {"contains": {"type": "string", "minLength": 1, "pattern": "\\S"}, "key": {"$ref": "#/$defs/modelKey"},
                         "value": {"type": ["boolean", "number", "string"]}, "at": {"$ref": "#/$defs/itemId"}}}},
        "reasks": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["contains", "key"],
          "properties": {"contains": {"type": "string", "minLength": 1, "pattern": "\\S"}, "key": {"$ref": "#/$defs/modelKey"},
                         "reason": {"enum": ["MISSING", "OUT_OF_RANGE", "UNKNOWN_UNIT", "VAGUE_QUANTITY", "RANGE_SPANS_OPTIONS", "COUNT_EXCEEDS_DAYS", "OTHER_BEVERAGE", "BEVERAGE_MISSING", "MISSING_NUMBER", "UNPARSED_VALUE", "INVALID_OPTION"]},
                         "at": {"$ref": "#/$defs/itemId"}}}}
      }
    }
  ],
  "$defs": {
    "itemId": {"type": "string", "pattern": "^Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?$"},
    "modelKey": {"type": "string", "pattern": "^Q[0-9]+(\\.D[0-9]{2})?(_[0-9]+)?(\\[(soju|beer|spirits|makgeolli|wine)\\])?\\.[a-z][a-z_]*$"}
  }
}
