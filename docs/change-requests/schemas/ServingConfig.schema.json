{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openit.local/boundary-contracts/ServingConfig.schema.json",
  "title": "ServingConfig",
  "description": "초안(CR-006). 모델 서빙 설정. model-lab이 모델 패키지(ModelPackageManifest.adapters[역할].serving_config)에 쓰고, release-gate가 릴리스 번들(ReleaseManifest)에 그대로 담고, model-runtime이 load에서 읽는다. 해시(serving_config_hash)는 받은 객체 그대로(기본값을 채우지 않고) JCS 해시이므로 모르는 키를 허용하면 해시가 달라질 수 있어 거부한다. 지금 model-runtime 코드의 SERVING_CONFIG_SCHEMA(serving_config.py)와 같은 뜻이다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt_template_version", "decoding", "max_attempts", "constraint", "output_contract", "protection_policy_version"],
  "properties": {
    "prompt_template_version": {"type": "string", "minLength": 1},
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_mode", "temperature", "seed", "max_tokens"],
      "properties": {
        "constraint_mode": {"enum": ["constrained", "none"]},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "max_tokens": {"type": "integer", "minimum": 1},
        "retry_temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "backend_version", "supported_features", "relax_policy_version"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "backend_version": {"type": "string", "minLength": 1},
        "supported_features": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "relax_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "output_contract": {"type": "integer", "minimum": 1},
    "protection_policy_version": {"type": "string", "minLength": 1}
  }
}
